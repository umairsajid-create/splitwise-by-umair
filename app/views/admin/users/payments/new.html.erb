<% content_for :title, "Add Payment - Splitwise Admin" %>

<style>
  .payment-container {
    max-width: 480px;
    margin: 40px auto;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .payment-header {
    text-align: center;
    margin-bottom: 30px;
  }

  .payment-header h2 {
    font-size: 24px;
    color: #333;
    font-weight: 600;
    margin: 0 0 10px 0;
  }

  .payment-header p {
    color: #999;
    font-size: 15px;
    margin: 0;
  }

  .payment-card {
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    padding: 30px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #333;
    margin-bottom: 8px;
  }

  .form-control {
    width: 100%;
    padding: 12px 16px;
    font-size: 16px;
    border: 1px solid #ccc;
    border-radius: 6px;
    box-sizing: border-box;
    transition: all 0.2s ease;
    background-color: #fcfcfc;
  }

  .form-control:focus {
    outline: none;
    border-color: #5bc5a7;
    box-shadow: 0 0 0 3px rgba(91, 197, 167, 0.15);
    background-color: #fff;
  }

  .form-select {
    appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23333' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 16px center;
    background-size: 16px;
  }

  .btn-splitwise {
    background-color: #5bc5a7;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 14px 24px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    width: 100%;
    transition: background-color 0.2s ease;
    margin-top: 10px;
  }

  .btn-splitwise:hover {
    background-color: #48a68b;
  }

  .btn-cancel {
    display: block;
    text-align: center;
    color: #999;
    text-decoration: none;
    margin-top: 20px;
    font-size: 15px;
    transition: color 0.2s ease;
  }

  .btn-cancel:hover {
    color: #666;
  }

  .error-box {
    background-color: #fee2e2;
    border: 1px solid #f87171;
    color: #b91c1c;
    padding: 16px;
    border-radius: 6px;
    margin-bottom: 24px;
  }

  .error-box h4 {
    margin: 0 0 10px 0;
    font-size: 15px;
  }

  .error-box ul {
    margin: 0;
    padding-left: 20px;
    font-size: 14px;
  }

  /* Splitwise style amount input wrapper */
  .amount-wrapper {
    display: flex;
    align-items: center;
    border: 1px solid #ccc;
    border-radius: 6px;
    background-color: #fcfcfc;
    transition: all 0.2s ease;
    overflow: hidden;
  }

  .amount-wrapper:focus-within {
    border-color: #5bc5a7;
    box-shadow: 0 0 0 3px rgba(91, 197, 167, 0.15);
    background-color: #fff;
  }

  .amount-currency {
    padding: 12px 16px;
    color: #666;
    font-weight: 600;
    background-color: #f3f3f3;
    border-right: 1px solid #ccc;
    font-size: 16px;
  }

  .amount-wrapper .form-control {
    border: none;
    border-radius: 0;
    background-color: transparent;
    box-shadow: none;
  }

  .amount-wrapper .form-control:focus {
    box-shadow: none;
  }
</style>

<div class="payment-container">
  <div class="payment-header">
    <h2>Activate Premium</h2>
    <p>Add a payment to upgrade <strong><%= @user.username %></strong></p>
  </div>

  <%= form_with model: @user, url: admin_user_payments_path(@user), local: true, method: :post do |f| %>
    <% if @user.errors.any? %>
      <div class="error-box">
        <h4><%= pluralize(@user.errors.count, "error") %> prohibited this payment from being saved:</h4>
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="payment-card">
      <%= f.fields_for :subscriptions, @user.subscriptions.last do |sub_form| %>
        
        <div class="form-group">
          <%= sub_form.label :plan, "Subscription Plan", class: "form-label" %>
          <%= sub_form.select :plan, Subscription.plans.keys.map { |k| [k.titleize, k] }, {}, class: "form-control form-select", id: "subscription_plan_select" %>
        </div>

        <div class="form-group">
          <%= sub_form.label :amount_cents, "Payment Amount (in cents)", class: "form-label" %>
          <div class="amount-wrapper" style="background-color: #f3f3f3;">
            <span class="amount-currency">PKR</span>
            <%= sub_form.number_field :amount_cents, class: "form-control", id: "subscription_amount_input", readonly: true, value: 5000, style: "background-color: transparent; cursor: not-allowed;" %>
          </div>
          <small style="color: #666; font-size: 13px; margin-top: 5px; display: block;">Amount is automatically determined by the selected plan.</small>
        </div>

        <div class="form-group">
          <%= sub_form.label :payment_method, "Payment Method", class: "form-label" %>
          <%= sub_form.select :payment_method, Subscription.payment_methods.keys.map { |k| [k.titleize, k] }, {}, class: "form-control form-select" %>
        </div>

        <div class="form-group">
          <%= sub_form.label :transaction_id, "Transaction ID", class: "form-label" %>
          <%= sub_form.text_field :transaction_id, class: "form-control", placeholder: "e.g. 123456789", required: true, pattern: "\\d{9}" %>
          <small style="color: #666; font-size: 13px; margin-top: 5px; display: block;">Must be exactly 9 digits.</small>
        </div>

      <% end %>

      <%= f.submit "Activate Subscription", class: "btn-splitwise" %>
      <%= link_to "Cancel", admin_user_path(@user), class: "btn-cancel" %>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener("turbo:load", function() {
    const planSelect = document.getElementById("subscription_plan_select");
    const amountInput = document.getElementById("subscription_amount_input");
    
    if (planSelect && amountInput) {
      const updateAmount = () => {
        if (planSelect.value === "monthly") {
          amountInput.value = 5000;
        } else if (planSelect.value === "yearly") {
          amountInput.value = 50000;
        }
      };
      
      // Initialize on load
      updateAmount();
      
      // Listen for changes
      planSelect.addEventListener("change", updateAmount);
    }
  });
</script>
