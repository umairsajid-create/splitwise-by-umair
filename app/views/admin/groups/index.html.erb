<% content_for :page_title, "Groups" %>

<div class="adm-page-header">
  <h1>Groups</h1>
  <p>Monitor all groups on the platform.</p>
</div>

<%= form_with url: admin_groups_path, method: :get, local: true do |f| %>
  <div class="adm-filter-bar">
    <%= f.text_field :q, value: params[:q], placeholder: "Search group name…", class: "adm-input", style: "flex:1;min-width:200px;" %>
    <%= f.select :active, [["All",""],["Active","true"],["Archived","false"]], {selected: params[:active]}, class: "adm-select" %>
    <%= f.submit "Filter", class: "adm-btn adm-btn--outline" %>
    <%= link_to "Clear", admin_groups_path, class: "adm-btn adm-btn--ghost" %>
  </div>
<% end %>

<div class="adm-card">
  <div class="adm-card__header"><span class="adm-card__title">Groups (<%= @groups.count %>)</span></div>
  <div class="adm-card__body">
    <% if @groups.any? %>
      <table class="adm-table">
        <thead>
          <tr><th>Name</th><th>Type</th><th>Members</th><th>Expenses</th><th>Status</th><th>Created</th><th>Actions</th></tr>
        </thead>
        <tbody>
          <% @groups.each do |group| %>
            <tr>
              <td style="font-weight:600;"><%= link_to group.name, admin_group_path(group), style:"color:#111;text-decoration:none;" %></td>
              <td><span class="adm-badge adm-badge--gray"><%= group.group_type.capitalize %></span></td>
              <td><%= group.group_members.count %></td>
              <td><%= group.expenses.active_records.count %></td>
              <td>
                <% if group.is_active %>
                  <span class="adm-badge adm-badge--green">Active</span>
                <% else %>
                  <span class="adm-badge adm-badge--gray">Archived</span>
                <% end %>
              </td>
              <td style="font-size:12px;color:#9ca3af;"><%= group.created_at.strftime("%b %d, %Y") %></td>
              <td>
                <div style="display:flex;gap:6px;">
                  <%= link_to "View", admin_group_path(group), class: "adm-btn adm-btn--outline" %>
                  <% if group.is_active %>
                    <%= button_to "Archive", archive_admin_group_path(group), method: :patch, class: "adm-btn adm-btn--red", data: { turbo: false, turbo_confirm: "Archive \"#{group.name}\"?" } %>
                  <% else %>
                    <%= button_to "Restore", restore_admin_group_path(group), method: :patch, class: "adm-btn adm-btn--green", data: { turbo: false } %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="adm-empty"><div class="adm-empty__icon">🏠</div>No groups found.</div>
    <% end %>
  </div>
</div>
