<% content_for :page_title, @group.name %>

<div style="margin-bottom:16px;">
  <%= link_to "← Groups", admin_groups_path, class: "adm-btn adm-btn--ghost" %>
</div>

<div class="adm-page-header">
  <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
    <div>
      <h1><%= @group.name %></h1>
      <p>
        <span class="adm-badge adm-badge--gray"><%= @group.group_type.capitalize %></span>
        &nbsp;
        <% if @group.is_active %>
          <span class="adm-badge adm-badge--green">Active</span>
        <% else %>
          <span class="adm-badge adm-badge--gray">Archived</span>
        <% end %>
      </p>
    </div>
    <div style="display:flex;gap:8px;">
      <% if @group.is_active %>
        <%= button_to "Archive Group", archive_admin_group_path(@group), method: :patch, class: "adm-btn adm-btn--red", data: { turbo: false, turbo_confirm: "Archive this group?" } %>
      <% else %>
        <%= button_to "Restore Group", restore_admin_group_path(@group), method: :patch, class: "adm-btn adm-btn--green", data: { turbo: false } %>
      <% end %>
    </div>
  </div>
</div>

<!-- Stats -->
<div class="adm-stats-grid" style="grid-template-columns:repeat(3,1fr);">
  <div class="adm-stat">
    <div class="adm-stat__label">Members</div>
    <div class="adm-stat__value"><%= @members.count %></div>
  </div>
  <div class="adm-stat">
    <div class="adm-stat__label">Expenses</div>
    <div class="adm-stat__value"><%= @recent_expenses.count %></div>
  </div>
  <div class="adm-stat adm-stat--green">
    <div class="adm-stat__label">Total Tracked</div>
    <div class="adm-stat__value">PKR <%= number_with_delimiter(@expense_total.round(2)) %></div>
  </div>
</div>

<!-- Members -->
<div class="adm-card">
  <div class="adm-card__header"><span class="adm-card__title">Members</span></div>
  <div class="adm-card__body">
    <table class="adm-table">
      <thead><tr><th>User</th><th>Role</th><th>Joined</th></tr></thead>
      <tbody>
        <% @members.each do |user| %>
          <tr>
            <td>
              <div style="display:flex;align-items:center;gap:8px;">
                <div class="adm-avatar"><%= user.username.first.upcase %></div>
                <div>
                  <div style="font-weight:600;"><%= user.username %></div>
                  <div style="font-size:12px;color:#9ca3af;"><%= user.email %></div>
                </div>
              </div>
            </td>
            <td><span class="adm-badge adm-badge--gray"><%= user.group_memberships.find_by(group: @group)&.role&.capitalize %></span></td>
            <td style="font-size:12px;color:#9ca3af;"><%= user.group_memberships.find_by(group: @group)&.joined_at&.strftime("%b %d, %Y") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<!-- Recent Expenses -->
<div class="adm-card">
  <div class="adm-card__header"><span class="adm-card__title">Recent Expenses</span></div>
  <div class="adm-card__body">
    <% if @recent_expenses.any? %>
      <table class="adm-table">
        <thead><tr><th>Title</th><th>Amount</th><th>By</th><th>Date</th></tr></thead>
        <tbody>
          <% @recent_expenses.each do |exp| %>
            <tr>
              <td style="font-weight:600;"><%= exp.title %></td>
              <td style="color:#16a34a;font-weight:700;">PKR <%= (exp.total_amount_cents / 100.0).round(2) %></td>
              <td style="font-size:12px;color:#9ca3af;"><%= exp.created_by&.username %></td>
              <td style="font-size:12px;color:#9ca3af;"><%= exp.expense_date&.strftime("%b %d, %Y") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="adm-empty"><div class="adm-empty__icon">💰</div>No expenses yet.</div>
    <% end %>
  </div>
</div>
