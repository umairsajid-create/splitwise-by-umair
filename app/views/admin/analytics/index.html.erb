<% content_for :page_title, "Dashboard" %>

<div class="adm-page-header">
  <h1>Dashboard</h1>
  <p>Platform overview — <%= Time.current.strftime("%B %d, %Y") %></p>
</div>

<!-- KPI Cards -->
<div class="adm-stats-grid">
  <div class="adm-stat">
    <div class="adm-stat__label">Total Users</div>
    <div class="adm-stat__value"><%= @analytics[:totals][:users] %></div>
    <div class="adm-stat__sub">Registered accounts</div>
  </div>
  <div class="adm-stat adm-stat--green">
    <div class="adm-stat__label">Total Groups</div>
    <div class="adm-stat__value"><%= @analytics[:totals][:groups] %></div>
    <div class="adm-stat__sub">Active groups</div>
  </div>
  <div class="adm-stat">
    <div class="adm-stat__label">Expenses & Settlements</div>
    <div class="adm-stat__value"><%= @analytics[:totals][:activities] %></div>
    <div class="adm-stat__sub">Active records</div>
  </div>
  <div class="adm-stat adm-stat--red">
    <div class="adm-stat__label">Blocked Users</div>
    <div class="adm-stat__value"><%= @nav_blocked_count %></div>
    <div class="adm-stat__sub"><%= link_to "Manage →", admin_users_path(blocked: true), style: "color:inherit;" %></div>
  </div>
  <div class="adm-stat">
    <div class="adm-stat__label">Pending Invitations</div>
    <div class="adm-stat__value"><%= @nav_pending_invites %></div>
    <div class="adm-stat__sub"><%= link_to "View →", admin_invitations_path(status: "pending"), style: "color:inherit;" %></div>
  </div>
</div>

<!-- Period Tabs -->
<div class="adm-period-tabs">
  <% [["day","Daily"],["week","Weekly"],["month","Monthly"]].each do |key, label| %>
    <%= link_to label, admin_root_path(period: key),
        class: "adm-period-tab #{@period == key ? 'active' : ''}" %>
  <% end %>
</div>
<p style="font-size:12px;color:#9ca3af;margin-bottom:20px;"><%= @analytics[:period_label] %></p>

<!-- Charts -->
<div class="adm-charts-grid"
     data-labels="<%= @analytics[:labels].to_json %>"
     data-users="<%= @analytics[:users_series].to_json %>"
     data-groups="<%= @analytics[:groups_series].to_json %>"
     data-activities="<%= @analytics[:activity_series].to_json %>">
  <div class="adm-chart-card">
    <div class="adm-chart-title">New Users <span style="color:#9ca3af;font-weight:400;">(Total: <%= @analytics[:users_series].sum %>)</span></div>
    <div style="position: relative; height: 200px; width: 100%;">
      <canvas id="admin-users-chart"></canvas>
    </div>
  </div>
  <div class="adm-chart-card">
    <div class="adm-chart-title">Groups Created <span style="color:#9ca3af;font-weight:400;">(Total: <%= @analytics[:groups_series].sum %>)</span></div>
    <div style="position: relative; height: 200px; width: 100%;">
      <canvas id="admin-groups-chart"></canvas>
    </div>
  </div>
  <div class="adm-chart-card">
    <div class="adm-chart-title">Activity <span style="color:#9ca3af;font-weight:400;">(Total: <%= @analytics[:activity_series].sum %>)</span></div>
    <div style="position: relative; height: 200px; width: 100%;">
      <canvas id="admin-activity-chart"></canvas>
    </div>
  </div>
</div>

<!-- Live Feeds -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 16px; margin-bottom: 24px;">
  
  <div class="adm-card">
    <div class="adm-card__header"><span class="adm-card__title">Latest Signups</span></div>
    <div class="adm-card__body">
      <% if @latest_users.any? %>
        <table class="adm-table" style="margin: 0; border: none;">
          <tbody>
            <% @latest_users.each do |user| %>
              <tr>
                <td style="padding: 12px 20px;">
                  <div style="display: flex; align-items: center; gap: 12px;">
                    <div class="adm-avatar" style="width:28px;height:28px;font-size:11px;"><%= user.username.first.upcase %></div>
                    <div>
                      <div style="font-weight: 600; color: #111; font-size: 13px;"><%= link_to user.username, admin_user_path(user), style: "color: inherit; text-decoration: none;" %></div>
                      <div style="color: #9ca3af; font-size: 11px;"><%= time_ago_in_words(user.created_at) %> ago</div>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="adm-empty">No recent signups.</div>
      <% end %>
    </div>
  </div>

  <div class="adm-card">
    <div class="adm-card__header"><span class="adm-card__title">Latest Expenses</span></div>
    <div class="adm-card__body">
      <% if @latest_expenses.any? %>
        <table class="adm-table" style="margin: 0; border: none;">
          <tbody>
            <% @latest_expenses.each do |exp| %>
              <tr>
                <td style="padding: 12px 20px;">
                  <div style="display: flex; flex-direction: column; gap: 4px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                      <strong style="color: #111; font-size: 13px;"><%= exp.title %></strong>
                      <span style="color: #22c55e; font-weight: 600; font-size: 13px;"><%= number_to_currency(exp.total_amount_cents / 100.0, unit: exp.currency + " ") %></span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: #9ca3af;">
                      <span>by <%= link_to exp.created_by.username, admin_user_path(exp.created_by), style: "color: inherit; text-decoration: none;" %> in <%= exp.group&.name || "Non-Group" %></span>
                      <span><%= time_ago_in_words(exp.created_at) %> ago</span>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="adm-empty">No recent expenses.</div>
      <% end %>
    </div>
  </div>

</div>

<% content_for :head do %>
  <%= javascript_import_module_tag "admin_charts" %>
<% end %>
